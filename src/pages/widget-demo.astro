---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
---

<Layout
  title="Calendar Widget Demo — Pavillion"
  description="See the embeddable Pavillion calendar widget in action. Drop one snippet into any website and your events show up styled to match."
>
  <SiteNav />

  <main class="widget-page">
    <div class="widget-container">
      <div id="calendar-widget"></div>
    </div>
  </main>

  <script is:inline async src="https://demo.pavillion.events/widget/pavillion-widget.js"></script>
  <script is:inline>
    window.Pavillion = window.Pavillion || function(){(window.Pavillion.q=window.Pavillion.q||[]).push([].slice.call(arguments))};
    Pavillion('init', {
      calendar: 'mitown',
      container: '#calendar-widget'
    });
  </script>
</Layout>

<style>
  .widget-page {
    padding: 2rem 1.5rem 4rem;
  }

  .widget-container {
    max-width: 72rem;
    margin: 0 auto;
  }
</style>
